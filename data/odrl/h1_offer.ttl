@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix fl:   <http://example.com/fl-policies#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/policies/h1-offer>
  a odrl:Offer ;
  odrl:assigner <http://example.com/parties/H1> ;
  fl:pairedWith <http://example.com/policies/h1-request> ;
  odrl:permission [
    a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target <http://example.com/assets/H1-data> ;
    odrl:constraint
      [ a odrl:Constraint ;
        odrl:leftOperand fl:epsilon ;
        odrl:operator odrl:lteq ;
        odrl:rightOperand "0.3"^^xsd:decimal ;
        fl:priority 1 ]
  ] .
